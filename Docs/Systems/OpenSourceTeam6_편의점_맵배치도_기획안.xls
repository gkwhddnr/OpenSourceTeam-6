<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<style>
table { border-collapse: collapse; font-family: "맑은 고딕", Malgun Gothic, sans-serif; font-size: 9.5pt; }
th, td { border: 0.5pt solid #B8C4D0; padding: 4px 4px; text-align: center; vertical-align: middle; mso-number-format:"\@"; }
.title { font-size: 14pt; font-weight: bold; background-color: #1B365D; color: #FFFFFF; text-align: left; padding-left: 12px; }
.subtitle { font-size: 9.5pt; background-color: #D9E1F2; color: #1B365D; text-align: left; padding-left: 12px; font-weight: bold; }
.sec-hdr { font-size: 11pt; font-weight: bold; background-color: #2F5597; color: #FFFFFF; text-align: left; padding-left: 10px; }
.axis { background-color: #263238; color: #ECEFF1; font-weight: bold; font-size: 8.5pt; }
.wall { background-color: #455A64; color: #FFFFFF; font-weight: bold; font-size: 8.5pt; border: 1pt solid #263238; }
.glass { background-color: #80DEEA; color: #004D40; font-weight: bold; font-size: 8.5pt; border: 1pt solid #00838F; }
.door { background-color: #00ACC1; color: #FFFFFF; font-weight: bold; font-size: 9pt; border: 1.5pt solid #006064; }
.staff-door { background-color: #8D6E63; color: #FFFFFF; font-weight: bold; font-size: 8.5pt; border: 1.5pt solid #4E342E; }
.floor { background-color: #FAF8F5; color: #78909C; font-size: 8pt; }
.aisle { background-color: #FFFDE7; color: #5D4037; font-weight: bold; font-size: 8.5pt; }
.queue { background-color: #FFF3E0; color: #E65100; font-weight: bold; font-size: 8.5pt; border: 1pt dashed #FB8C00; }
.backroom { background-color: #D7CCC8; color: #3E2723; font-weight: bold; font-size: 8.5pt; border: 1pt solid #8D6E63; }
.backroom-floor { background-color: #EFEBE9; color: #4E342E; font-size: 8.5pt; }
.rest-point { background-color: #A5D6A7; color: #1B5E20; font-weight: bold; font-size: 8.5pt; border: 1.5pt solid #2E7D32; }
.cooler { background-color: #B3E5FC; color: #01579B; font-weight: bold; font-size: 8.5pt; border: 1pt solid #0288D1; }
.fresh { background-color: #C8E6C9; color: #1B5E20; font-weight: bold; font-size: 8.5pt; border: 1pt solid #388E3C; }
.hotbar { background-color: #FFCCBC; color: #BF360C; font-weight: bold; font-size: 8.5pt; border: 1pt solid #E64A19; }
.trash { background-color: #CFD8DC; color: #263238; font-weight: bold; font-size: 8.5pt; border: 1pt solid #607D8B; }
.shelf { background-color: #FFE082; color: #4E342E; font-weight: bold; font-size: 8.5pt; border: 1pt solid #FFA000; }
.icecream { background-color: #E1BEE7; color: #4A148C; font-weight: bold; font-size: 8.5pt; border: 1pt solid #8E24AA; }
.dining { background-color: #DCEDC8; color: #33691E; font-weight: bold; font-size: 8.5pt; border: 1pt solid #689F38; }
.counter { background-color: #C5E1A5; color: #1B5E20; font-weight: bold; font-size: 9pt; border: 1.5pt solid #558B2F; }
.pos-staff { background-color: #81C784; color: #0D3B10; font-weight: bold; font-size: 8.5pt; border: 1.5pt solid #2E7D32; }
.pos-boss { background-color: #FFE0B2; color: #E65100; font-weight: bold; font-size: 8.5pt; border: 1.5pt solid #F57C00; }
.tobacco { background-color: #BCAAA4; color: #212121; font-weight: bold; font-size: 8.5pt; border: 1pt solid #5D4037; }
.sidewalk { background-color: #ECEFF1; color: #37474F; font-weight: bold; font-size: 8.5pt; }
.spawn { background-color: #FFCDD2; color: #B71C1C; font-weight: bold; font-size: 8.5pt; border: 1.5pt solid #C62828; }
.target-pin { background-color: #FFF59D; color: #B71C1C; font-weight: bold; font-size: 8pt; border: 1pt dashed #FBC02D; }
.tbl-hdr { background-color: #2F5597; color: #FFFFFF; font-weight: bold; }
.left { text-align: left; padding-left: 8px; white-space: normal; }
</style></head><body>
